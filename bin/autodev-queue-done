#!/usr/bin/env bash
# autodev-queue-done — exit 0 when a repo's task queue is fully drained.
#
# Used by agos-daemon to decide when to stop looping for good. Exit codes:
#   0 = queue drained, supervisor should shut down
#   1 = work remains, keep going
#   2 = cannot tell (file missing / unparseable) — keep going, fail safe
#
# Usage:
#   autodev-queue-done checkbox <file>
#   autodev-queue-done table    <file> <STATUS> [STATUS...]
#
#   checkbox  counts lines matching "- [ ]" (unchecked Markdown task)
#   table     counts "| ID | STATUS |" rows whose status is one of STATUS
#
# Deliberately conservative: anything it cannot parse is reported as "work
# remains", because a false "done" would silently abandon a project.

if [ -z "${BASH_VERSION:-}" ]; then exec bash "$0" "$@"; fi

MODE="${1:-}"
FILE="${2:-}"

if [ -z "$MODE" ] || [ -z "$FILE" ] || [ ! -f "$FILE" ]; then
  echo "autodev-queue-done: cannot read '$FILE'" >&2
  exit 2
fi

case "$MODE" in
  checkbox)
    # `grep -c` prints 0 AND exits 1 when there are no matches, so `|| echo 0`
    # would append a SECOND line and make N a two-line string. Use `|| true`.
    N=$(grep -cE '^[[:space:]]*-[[:space:]]*\[[[:space:]]\]' "$FILE" 2>/dev/null || true)
    ;;
  table)
    shift 2
    [ $# -gt 0 ] || { echo "table mode needs >=1 STATUS word" >&2; exit 2; }
    pat='^\|[[:space:]]*[A-Za-z]+-[0-9A-Za-z.]+[[:space:]]*\|[[:space:]]*('
    first=1
    for s in "$@"; do
      if [ $first -eq 1 ]; then pat="${pat}${s}"; first=0
      else pat="${pat}|${s}"; fi
    done
    pat="${pat})[[:space:]]*\|"
    N=$(grep -cE "$pat" "$FILE" 2>/dev/null || true)
    ;;
  paired)
    # Arg positions: $1=paired $2=file $3=heading-regex $4..=terminal tokens.
    # The regex is $3, NOT $2 — reading $2 passed the FILENAME to awk as the
    # match pattern, so nothing ever matched and every repo looked "drained".
    [ $# -ge 4 ] || { echo "paired mode needs <heading-regex> <token> [token...]" >&2; exit 2; }
    HRE="$3"; shift 3
    TOXT=""
    for s in "$@"; do TOXT="$TOXT${TOXT:+,}$s"; done
    # A heading block is terminal ONLY when a token appears in a status
    # position — never merely because the word appears somewhere in the prose.
    #
    # The old rule was `index($0, token)`, which misread real queue files. A
    # task may legitimately mention an earlier one:
    #     ### T076 — Add Core integration client examples
    #     **Status:** TODO (2026-10-04 — next actionable) — T075 is DONE.
    # That trailing reference made T076 count as complete, so the queue
    # under-reported by one — and, worse, the same rule can report a queue as
    # fully drained while work remains, which makes the supervisor exit for good
    # and abandon the project. A false "done" is the one failure this tool must
    # never make.
    #
    # Rules, in order:
    #   1. A line declaring `Status:` is authoritative. The first word after it
    #      decides. Once seen, later prose cannot override it.
    #   2. With no status line in the block, a token at the START of a line
    #      counts (covers `- [x] SEC-001 — DONE` and table-ish layouts).
    #   3. Otherwise the block is treated as NOT terminal — fail-safe.
    #
    # Boundaries are written as explicit character classes rather than \b so
    # this behaves identically under gawk, mawk and busybox awk.
    N=$(awk -v hre="$HRE" -v toks="$TOXT" '
      # The boundary must accept END OF STRING as well as a non-word character:
      # a status value of exactly "DONE" with nothing after it is the common
      # case, and requiring a following character silently failed to match it.
      function is_token(s,   t) {
        for (t in T) if (match(s, "^" t "([^A-Za-z0-9_]|$)")) return 1
        return 0
      }
      BEGIN { n=split(toks, a, ","); for(i=1;i<=n;i++) T[a[i]]=1 }
      $0 ~ hre {
        if (inhdr && !term) rem++
        inhdr=1; term=0; sawstatus=0; next
      }
      inhdr && !term {
        line=$0
        # (1) explicit status declaration wins, and is final for this block
        if (match(line, "[Ss][Tt][Aa][Tt][Uu][Ss][^:]*:[[:space:]]*")) {
          sawstatus=1
          rest = substr(line, RSTART + RLENGTH)
          gsub(/^[*_`[:space:]]+/, "", rest)
          if (is_token(rest)) term=1
          next
        }
        # (2) fallback: token at the start of a line
        if (!sawstatus) {
          s = line
          gsub(/^[[:space:]]*([-*+][[:space:]]+|\|)?[[:space:]]*[*_`[:space:]]*/, "", s)
          if (is_token(s)) term=1
        }
      }
      END { if (inhdr && !term) rem++; print rem+0 }
    ' "$FILE" 2>/dev/null || true)
    ;;
  *)
    echo "autodev-queue-done: unknown mode '$MODE'" >&2
    exit 2
    ;;
esac

N=${N:-0}
if [ "$N" -eq 0 ] 2>/dev/null; then
  echo "queue drained: $FILE has no remaining tasks"
  exit 0
fi
echo "$N task(s) remaining in $FILE"
exit 1